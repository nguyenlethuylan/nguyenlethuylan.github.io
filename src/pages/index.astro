    <style>
        /* CSS Reset & VS Code Theme Variables */
        * { box-sizing: border-box; margin: 0; padding: 0; }
        :root {
            --bg-color: #1e1e1e; --text-main: #d4d4d4; --text-muted: #6a9955;
            --accent-blue: #569cd6; --accent-teal: #4ec9b0; --accent-yellow: #dcdcaa;
            --accent-string: #ce9178; --border-color: #333333; --hover-bg: #2a2d2e; --terminal-bg: #181818;
        }
        body {
            background-color: var(--bg-color); color: var(--text-main);
            font-family: 'JetBrains Mono', 'Fira Code', 'Consolas', monospace; line-height: 1.7; padding: 40px 20px;
        }
        .container { max-width: 900px; margin: 0 auto; }
        header { display: flex; justify-content: space-between; align-items: flex-end; border-bottom: 1px solid var(--border-color); padding-bottom: 20px; margin-bottom: 50px; flex-wrap: wrap; gap: 20px; }
        .site-branding h1 { font-size: 1.2rem; color: var(--accent-blue); font-weight: normal; }
        .site-branding p { font-size: 0.85rem; color: var(--text-muted); margin-top: 5px; }
        .site-branding span.bracket { color: var(--accent-blue); }
        .site-branding span.classname { color: var(--accent-teal); }
        .nav-links { display: flex; gap: 25px; list-style: none; font-size: 0.9rem; }
        .nav-links a { color: var(--text-main); text-decoration: none; transition: color 0.2s ease; }
        .nav-links a.active, .nav-links a:hover { color: var(--accent-yellow); }
        .content-section { margin-bottom: 60px; }
        .content-section h2 { font-size: 1.5rem; color: var(--accent-yellow); font-weight: normal; margin-bottom: 20px; display: flex; align-items: center; }
        .content-section h2::before { content: 'def '; color: var(--accent-blue); margin-right: 8px; }
        .content-section h2::after { content: '():'; color: var(--text-main); }
        .content-section p { font-size: 1rem; color: var(--text-main); margin-bottom: 15px; text-align: justify; }
        .intro-section h2::before, .intro-section h2::after { content: ''; }
        .intro-section h2 { font-size: 2.2rem; color: var(--accent-yellow); }
        .intro-section h2 span.func { color: var(--accent-yellow); }
        .intro-section h2 span.string { color: var(--accent-string); }
        .intro-section h2 span.punct { color: var(--text-main); }
        .terminal-block { background-color: var(--terminal-bg); padding: 20px; border-radius: 6px; border: 1px solid var(--border-color); margin-top: 10px; font-size: 0.95rem; }
        .terminal-block a { color: var(--accent-teal); text-decoration: none; }
        .terminal-block a:hover { text-decoration: underline; }
        footer { margin-top: 80px; border-top: 1px dashed var(--border-color); padding-top: 30px; font-size: 0.85rem; color: #858585; text-align: center; }
    </style>
</head>
<body>
